{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": ["waivers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "waivers": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["advisoryId", "package", "reason", "owner", "createdAt", "expiresAt"],
        "properties": {
          "advisoryId": {
            "pattern": "^(GHSA|CVE)-",
            "type": "string"
          },
          "package": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 10,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          },
          "createdAt": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "expiresAt": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          }
        }
      }
    }
  }
}
