{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": { "enabled": true, "minimumReleaseAge": null, "labels": ["security"] },
  "packageRules": [
    {
      "groupName": "tooling",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "typescript",
        "eslint",
        "/^@eslint//",
        "prettier",
        "vitest",
        "/^@vitest//",
        "turbo",
        "tsx"
      ]
    },
    {
      "groupName": "server",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^@nestjs//", "/^@colyseus//", "drizzle-orm", "drizzle-kit", "pg"]
    },
    {
      "groupName": "client",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "/^@types/react/",
        "three",
        "/^@react-three//",
        "vite"
      ]
    },
    {
      "groupName": "docker",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchDatasources": ["docker"]
    },
    {
      "groupName": "github-actions",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchManagers": ["github-actions"]
    },
    { "matchUpdateTypes": ["major"], "labels": ["breaking-update"], "groupName": null }
  ]
}
