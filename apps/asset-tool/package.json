{
  "name": "@uo3/asset-tool",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "bin": {
    "uo3-asset-tool": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "echo \"No integration tests in @uo3/asset-tool\""
  },
  "dependencies": {
    "@uo3/config": "workspace:*",
    "@uo3/content": "workspace:*",
    "@uo3/domain": "workspace:*",
    "@uo3/uo-formats": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uo3/test-kit": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
