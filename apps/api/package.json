{
  "name": "@duskmarch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@duskmarch/config": "workspace:*",
    "@duskmarch/content": "workspace:*",
    "@duskmarch/db": "workspace:*",
    "@duskmarch/domain": "workspace:*",
    "@duskmarch/protocol": "workspace:*",
    "@duskmarch/rules": "workspace:*",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "@node-rs/argon2": "2.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@duskmarch/test-kit": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
