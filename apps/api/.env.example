# NODE_ENV задаётся окружением процесса; значение в файле не влияет на выбор среды.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://duskmarch:CHANGE_ME_LOCAL_DEV_ONLY@127.0.0.1:5432/duskmarch_dev
VALKEY_URL=redis://127.0.0.1:6379
VALKEY_PASSWORD=
NATS_URL=nats://127.0.0.1:4222
NATS_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
SHUTDOWN_TIMEOUT_MS=15000
API_HOST=127.0.0.1
API_PORT=3001
# Вне production пустые ключи identity создаются при старте (сессии не переживут рестарт).
# Формат: JSON-массив [{"kid":"k1","privateKeyPem":"-----BEGIN PRIVATE KEY-----..."}].
IDENTITY_JWT_SIGNING_KEYS_JSON=
IDENTITY_JWT_ISSUER=duskmarch
IDENTITY_JWT_AUDIENCE=duskmarch-api
# JSON {"1":"<base64 32 байта>"}.
IDENTITY_TOTP_KEYS_JSON=
IDENTITY_TOTP_KEY_VERSION=1
IDENTITY_BACKUP_CODE_PEPPER=
IDENTITY_PUBLIC_URL=http://localhost:5273
IDENTITY_TRUSTED_ORIGINS=http://localhost:5273,http://localhost:5274
IDENTITY_TOS_VERSION=2026-11-01
IDENTITY_PRIVACY_VERSION=2026-11-01
IDENTITY_BLOCKED_EMAIL_DOMAINS=
IDENTITY_REGISTRATION_CHALLENGE=off
IDENTITY_ARGON2_MEMORY_KIB=19456
IDENTITY_ARGON2_TIME_COST=2
MAIL_TRANSPORT=log
MAIL_SMTP_URL=
MAIL_FROM=Duskmarch <no-reply@duskmarch.invalid>
OAUTH_REDIRECT_BASE_URL=http://localhost:3001
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5273,http://localhost:5274
CORS_ALLOW_CREDENTIALS=true
ENABLE_SWAGGER=true
