# NODE_ENV задаётся окружением процесса; значение в файле не влияет на выбор среды.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://duskmarch:CHANGE_ME_LOCAL_DEV_ONLY@127.0.0.1:5432/duskmarch_dev
VALKEY_URL=redis://127.0.0.1:6379
VALKEY_PASSWORD=
NATS_URL=nats://127.0.0.1:4222
NATS_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
SHUTDOWN_TIMEOUT_MS=15000
GAME_HOST=127.0.0.1
GAME_PORT=2567
GAME_HEALTH_PORT=2568
SHARD_ID=local-dev
SHARD_RULESET_PRESET=standard
# Необязательный файл переопределения правил (JSON или YAML).
SHARD_RULESET_FILE=
# Каталог пакета мира (pack.json). Пусто — синтетический план proving (только вне production).
WORLD_PACK_DIR=
GAME_NODE_ROLE=all
GAME_NODE_ID=node-1
GAME_PUBLIC_WS_URL=ws://127.0.0.1:2567
GAME_HEARTBEAT_MS=5000
GAME_RECONNECT_WINDOW_MS=30000
GAME_IDLE_TIMEOUT_MS=1800000
GAME_SHUTDOWN_HARD_TIMEOUT_MS=30000
GAME_PARTITION_CAPACITY=500
GAME_STAFF_BUFFER=20
GAME_MOTD=Добро пожаловать на Duskmarch
