{
  "name": "@duskmarch/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./infra": {
      "types": "./dist/infra.d.ts",
      "import": "./dist/infra.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@duskmarch/config": "workspace:*",
    "@duskmarch/domain": "workspace:*",
    "@nats-io/transport-node": "3.5.0",
    "drizzle-orm": "0.45.4",
    "iovalkey": "0.4.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.11",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
