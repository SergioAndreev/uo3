{
  "name": "@uo3/ui-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "echo \"No integration tests in @uo3/ui-kit\""
  },
  "dependencies": {
    "@uo3/config": "workspace:*",
    "@uo3/domain": "workspace:*",
    "@uo3/protocol": "workspace:*",
    "react": "19.1.10"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "25.0.1",
    "react-dom": "19.1.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
