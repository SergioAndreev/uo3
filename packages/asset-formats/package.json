{
  "name": "@duskmarch/asset-formats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/pack/index.d.ts",
      "import": "./dist/pack/index.js"
    },
    "./chunk": {
      "types": "./dist/chunk/index.d.ts",
      "import": "./dist/chunk/index.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "import": "./dist/world/index.js"
    },
    "./palette": {
      "types": "./dist/palette/index.d.ts",
      "import": "./dist/palette/index.js"
    },
    "./glb": {
      "types": "./dist/glb/index.d.ts",
      "import": "./dist/glb/index.js"
    },
    "./synthetic": {
      "types": "./dist/synthetic/index.d.ts",
      "import": "./dist/synthetic/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@duskmarch/domain": "workspace:*",
    "@sinclair/typebox": "catalog:"
  },
  "devDependencies": {
    "@duskmarch/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
