{
  "$schema": "https://turborepo.com/schema.json",
  "concurrency": "2",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "vite.config.ts",
        "index.html",
        "tsconfig/**",
        ".env*"
      ],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json", "tsconfig/**"],
      "outputs": []
    },
    "//#typecheck:root": {
      "dependsOn": ["@duskmarch/config#build", "@duskmarch/db#build"],
      "inputs": [
        "scripts/**",
        "infra/**/*.ts",
        "vitest.workspace.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "reports/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#check:env:run": {
      "dependsOn": ["@duskmarch/config#build"],
      "inputs": [".env.example", "apps/*/.env.example", "scripts/check-env.ts"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "reports/**"]
    }
  }
}
