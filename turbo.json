{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": ["tsconfig.base.json", ".npmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.integration.test.ts"
      ],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.md"],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.md"],
      "outputs": ["test-results/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.md"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "VALKEY_URL",
        "NATS_URL",
        "PG_PORT",
        "VALKEY_PORT",
        "NATS_PORT",
        "NATS_MONITOR_PORT"
      ],
      "outputs": ["test-results/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#env:parity": {
      "dependsOn": ["@uo3/config#build"],
      "inputs": [
        "packages/config/src/env/**",
        ".env.example",
        "apps/*/.env.example",
        "scripts/check-env.ts"
      ],
      "outputs": []
    }
  }
}
