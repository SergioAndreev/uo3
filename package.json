{
  "name": "duskmarch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@pm2/io"
      ]
    },
    "packageExtensions": {
      "@nestjs/platform-express": {
        "peerDependencies": {
          "rxjs": "*"
        }
      }
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test --concurrency=2 && vitest run --project unit scripts infra --no-file-parallelism",
    "lint": "turbo run build --filter=@duskmarch/config && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "turbo run build --filter=@duskmarch/config && prettier --check .",
    "check:boundaries": "depcruise --config .dependency-cruiser.mjs apps packages",
    "check:workspace-manifests": "tsx scripts/check-workspace-manifests.ts",
    "check:node": "tsx scripts/check-node-version.ts",
    "dev": "turbo run dev",
    "bootstrap": "sh scripts/bootstrap.sh",
    "doctor": "turbo run build --filter=@duskmarch/db && tsx scripts/doctor.ts",
    "env:reset": "turbo run build --filter=@duskmarch/db && tsx scripts/env-reset.ts",
    "check:env": "turbo run //#check:env:run",
    "check:env:run": "tsx scripts/check-env.ts",
    "db:generate": "turbo run build --filter=@duskmarch/db^... && pnpm --filter @duskmarch/db db:generate",
    "db:migrate": "turbo run build --filter=@duskmarch/db^... && pnpm --filter @duskmarch/db db:migrate",
    "db:seed": "turbo run build --filter=@duskmarch/db^... && pnpm --filter @duskmarch/db db:seed",
    "test:integration": "turbo run test:integration --concurrency=1 && vitest run --project integration infra scripts --no-file-parallelism --passWithNoTests"
  },
  "devDependencies": {
    "@duskmarch/config": "workspace:*",
    "@duskmarch/db": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "16.10.4",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
