{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UO3 Asset Provenance Manifest (ADR-002)",
  "type": "object",
  "required": ["schemaVersion", "maxBinaryBytes", "assets"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "maxBinaryBytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "license", "source", "addedInPhase"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "license": { "enum": ["CC0-1.0", "synthetic-generated"] },
          "source": { "type": "string", "minLength": 1 },
          "addedInPhase": { "type": "string", "pattern": "^P[0-9]{2}$" }
        }
      }
    }
  }
}
