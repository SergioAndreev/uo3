{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": ["schemaVersion", "maxBinaryBytes", "assets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "maxBinaryBytes": {
      "const": 524288,
      "type": "number"
    },
    "assets": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["path", "sha256", "license", "source", "addedInPhase"],
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "license": {
            "anyOf": [
              {
                "const": "CC0-1.0",
                "type": "string"
              },
              {
                "const": "CC-BY-4.0",
                "type": "string"
              },
              {
                "const": "original",
                "type": "string"
              },
              {
                "const": "synthetic-generated",
                "type": "string"
              }
            ]
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "addedInPhase": {
            "pattern": "^P\\d{2}$",
            "type": "string"
          }
        }
      }
    }
  }
}
