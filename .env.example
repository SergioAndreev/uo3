# UO3 Local Infrastructure & Docker Compose Environment Template
NODE_ENV=development

# PostgreSQL 17 (core profile)
PG_USER=uo3
PG_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
PG_PORT=5432

# Valkey 8 (core profile)
VALKEY_PORT=6379

# NATS JetStream 2.10+ (core profile)
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# Observability profile ports (optional)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000

# Shared local connection URIs
DATABASE_URL=postgresql://uo3:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/uo3_dev
TEST_DATABASE_URL=postgresql://uo3:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/uo3_test
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
