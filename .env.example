# Параметры Docker Compose и команд db:*. Скопируйте в .env.
PG_USER=duskmarch
PG_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
PG_PORT=5432
VALKEY_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
# При смене PG_PORT измените порт и здесь.
DATABASE_URL=postgresql://duskmarch:CHANGE_ME_LOCAL_DEV_ONLY@127.0.0.1:5432/duskmarch_dev
DATABASE_TEST_URL=postgresql://duskmarch:CHANGE_ME_LOCAL_DEV_ONLY@127.0.0.1:5432/duskmarch_test
